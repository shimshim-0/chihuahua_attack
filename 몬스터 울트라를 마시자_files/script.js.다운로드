const tabs = [...dialog.querySelectorAll('[role="tab"]')];
function selectTab(tab, focus = false) {
  tabs.forEach(item => {
    const selected = item === tab;
    item.setAttribute('aria-selected', String(selected));
    item.tabIndex = selected ? 0 : -1;
    document.getElementById(item.dataset.tab).hidden = !selected;
  });
  if (focus) tab.focus();
}
tabs.forEach((tab, index) => {
  tab.addEventListener('click', () => selectTab(tab));
  tab.addEventListener('keydown', event => {
    let next;
    if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
    if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
    if (event.key === 'Home') next = 0;
    if (event.key === 'End') next = tabs.length - 1;
    if (next !== undefined) { event.preventDefault(); selectTab(tabs[next], true); }
  });
});

function clearAnimation() {
  canAnimation?.cancel();
  ghost?.remove();
  ghost = null;
  document.querySelector('#expanded-can').style.visibility = '';
}
function openIngredients(trigger) {
  if (dialog.open) return;
  lastTrigger = trigger;
  selectTab(tabs[0]);
  previousOverflow = document.body.style.overflow;
  document.body.style.overflow = 'hidden';
  dialog.showModal();
  dialog.classList.add('dialog-enter');
  // The clicked product visually grows into the larger ingredient view.
  if (trigger.classList.contains('can-button') && !reducedMotion.matches) {
    const original = trigger.querySelector('img');
    const target = document.querySelector('#expanded-can');
    const start = original.getBoundingClientRect();
    const end = target.getBoundingClientRect();
    target.style.visibility = 'hidden';
    ghost = original.cloneNode();
    ghost.alt = '';
    ghost.setAttribute('aria-hidden', 'true');
    Object.assign(ghost.style, { position: 'fixed', left: `${end.left}px`, top: `${end.top}px`, width: `${end.width}px`, height: `${end.height}px`, zIndex: '20', objectFit: 'contain', pointerEvents: 'none', transformOrigin: 'top left' });
    ghost.className = '';
    dialog.append(ghost);
    canAnimation = ghost.animate([
      { transform: `translate(${start.left - end.left}px, ${start.top - end.top}px) scale(${start.width / end.width}, ${start.height / end.height})`, opacity: 0.8 },
      { transform: 'translate(0, 0) scale(1)', opacity: 1 }
    ], { duration: 550, easing: 'cubic-bezier(.16,1,.3,1)' });
    canAnimation.onfinish = clearAnimation;
  }
}
document.querySelectorAll('[data-open]').forEach(button => button.addEventListener('click', () => openIngredients(button)));
dialog.querySelector('.dialog-close').addEventListener('click', () => dialog.close());
dialog.addEventListener('click', event => {
  const bounds = dialog.getBoundingClientRect();
  if (event.target === dialog && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) dialog.close();
});
dialog.addEventListener('close', () => {
  clearAnimation();
  document.body.style.overflow = previousOverflow || '';
  dialog.classList.remove('dialog-enter');
  lastTrigger?.focus({ preventScroll: true });
});

const responseDialog = document.querySelector('#response-dialog');
const responseContent = document.querySelector('#response-content');
const accountNumber = '1001-3101-1487';
let responseTrigger;
let responseOverflow;

function showResponse(accepted, trigger) {
  responseTrigger = trigger;
  responseContent.replaceChildren();
  responseDialog.classList.toggle('image-response', !accepted);
  if (accepted) {
    const heading = document.createElement('h2');
    heading.textContent = '제것도 ㅎㅎ;;';
    const number = document.createElement('p');
    number.className = 'account-number';
    number.textContent = accountNumber;
    const copy = document.createElement('button');
    copy.className = 'btn btn-white';
    copy.textContent = '계좌번호 복사';
    const status = document.createElement('p');
    status.className = 'copy-status';
    status.setAttribute('role', 'status');
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(accountNumber);
        status.textContent = '복사했어요.';
      } catch {
        status.textContent = '번호를 길게 눌러 복사하세요.';
      }
    });
    responseContent.append(heading, number, copy, status);
  } else {
    const image = document.createElement('img');
    image.src = 'assets/decline-response.jpg';
    image.alt = '거절 버튼을 누르면 나타나는 고릴라 사진';
    image.width = 486;
    image.height = 630;
    responseContent.append(image);
  }
  responseOverflow = document.body.style.overflow;
  document.body.style.overflow = 'hidden';
  responseDialog.showModal();
}
document.querySelector('#accept-choice').addEventListener('click', event => showResponse(true, event.currentTarget));
document.querySelector('#decline-choice').addEventListener('click', event => showResponse(false, event.currentTarget));
responseDialog.querySelector('.response-close').addEventListener('click', () => responseDialog.close());
responseDialog.addEventListener('click', event => {
  const bounds = responseDialog.getBoundingClientRect();
  if (event.target === responseDialog && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) responseDialog.close();
});
responseDialog.addEventListener('close', () => {
  document.body.style.overflow = responseOverflow || '';
  responseTrigger?.focus({preventScroll: true});
});
